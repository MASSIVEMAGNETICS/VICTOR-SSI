# Required: generate with `victor-operator init`
VICTOR_API_TOKEN=replace-me

# Local-only by default. Bind to 0.0.0.0 only behind a private network such as Tailscale.
VICTOR_HOST=127.0.0.1
VICTOR_PORT=8765
VICTOR_WORKSPACE=%USERPROFILE%\\VictorWorkspace
VICTOR_DATA_DIR=%LOCALAPPDATA%\\VictorOperator

# Optional natural-language planner. Explicit JSON plans work without an API key.
OPENAI_API_KEY=
VICTOR_MODEL=gpt-5.5

# Semicolon-separated browser domains allowed without approval.
VICTOR_ALLOWED_DOMAINS=github.com;docs.github.com;openai.com;platform.openai.com

# Browser behavior
VICTOR_BROWSER_HEADLESS=false
VICTOR_BROWSER_CHANNEL=chrome

# Worker limits
VICTOR_MAX_STEPS=40
VICTOR_COMMAND_TIMEOUT_SECONDS=120
