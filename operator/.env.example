# Required: generate with `victor-operator init`
VICTOR_API_TOKEN=replace-me

# Local-only by default. Bind to 0.0.0.0 only behind a private encrypted network.
VICTOR_HOST=127.0.0.1
VICTOR_PORT=8765
VICTOR_WORKSPACE=%USERPROFILE%\\VictorWorkspace
VICTOR_DATA_DIR=%LOCALAPPDATA%\\VictorOperator

# VICTOR_MODEL_SOVEREIGNTY
# Victor Operator intentionally has no hosted-model API key or cloud-cognition fallback.
# Submit explicit execution steps until a provenance-verified Victor-owned local cognition adapter exists.

# Semicolon-separated browser domains allowed without approval.
VICTOR_ALLOWED_DOMAINS=github.com;docs.github.com

# Browser behavior
VICTOR_BROWSER_HEADLESS=false
VICTOR_BROWSER_CHANNEL=chrome

# Worker limits
VICTOR_MAX_STEPS=40
VICTOR_COMMAND_TIMEOUT_SECONDS=120
